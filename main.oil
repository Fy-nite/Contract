module Kernel32 version 1.0.0

@DllImport("kernel32.dll")
class Test.Kernel32 {
    static method GetTickCount() -> int32 {
        // #line 5:39 "static fn GetTickCount() -> int { }"
        ldc.i4 0
        // #line 5:39 "static fn GetTickCount() -> int { }"
        ret
    }
}

class Test.Program {
    static method Main() -> void {
        local ticks: int32

        // #line 10:21 "var ticks = Kernel32.GetTickCount();"
        call Test.Kernel32.GetTickCount() -> int32
        // #line 10:21 "var ticks = Kernel32.GetTickCount();"
        stloc ticks
        // #line 11:20 "IO.Println(ticks);"
        ldloc ticks
        // #line 11:20 "IO.Println(ticks);"
        call IO.Println(object) -> void
        // #line 11:20 "IO.Println(ticks);"
        pop
        // #line 11:20 "IO.Println(ticks);"
        ret
    }
}

