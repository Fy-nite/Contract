Contract Program {
    static fn Main() {
        var day: int = 3;
        switch (day) {
            case 1: IO.Println("Monday");
            case 2: IO.Println("Tuesday");
            case 3: IO.Println("Wednesday");
            else: IO.Println("Weekend");
        }
        for (var i: int = 0; i < 10; i = i + 1) {
            if (i == 2) {
                continue;
            }
            if (i > 5) {
                break;
            }
            IO.Println(i);
        }
        for (var i: int = 1; i <= 20; i = i + 1) {
            if (i % 15 == 0) {
                IO.Println("fizzbuzz");
            } else if (i % 3 == 0) {
                IO.Println("fizz");
            } else if (i % 5 == 0) {
                IO.Println("buzz");
            } else {
                IO.Println(i);
            }
        }
    }
}
