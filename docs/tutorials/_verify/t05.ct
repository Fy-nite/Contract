Contract Rectangle {
    width: int;
    height: int;

    fn area() -> int {
        return this.width * this.height;
    }
}

Contract Counter {
    count: int;

    constructor() {
        this.count = 7;
        IO.Println("Counter created");
    }

    static fn Main() {
        var r: Rectangle = new Rectangle();
        r.width = 5;
        r.height = 3;
        IO.Println(r.area());
        var c: Counter = new Counter();
    }
}

