import __builtin.std;

// SpinWorld's Contract gamepak: compiled and run by ContractGamepack.
// Main() runs once at startup; OnUpdate(dt) ticks every frame.
// <AssemblyRef(Path: "../../../libs/V12.Monogame/V12.Monogame.GL/bin/Debug/net10.0/V12.Bindings.dll")>
import V12.World;
import V12.Components;
import V12.Registry;
Contract Program {
    static angle: float;
    static spinId: long;

    static fn Main() {
        Program.angle = 0.0;
        IO.Println("[SpinWorld] Main — spawning box from Contract");
        Program.spinId = V12.World.SpawnElementAt("ContractCube", 0.0, 1.5, -4.0);
        V12.Components.AddMesh(Program.spinId, 0, 1.0, 1.0, 1.0);
        V12.Components.SetColor(Program.spinId, 1.0, 0.4, 0.2, 1.0);
        V12.Components.AddCollider(Program.spinId, 0, 1.0, 1.0, 1.0);
    
        V12.Log.Info("[SpinWorld] cube spawned from Contract Main");
    }

    static fn OnUpdate(dt: float) {
        Program.angle = Program.angle + 60.0 * dt;
        if (Program.angle > 360.0) {
            Program.angle = Program.angle - 360.0;
            IO.Println("[SpinWorld] full turn");
        }
        V12.Components.SetFloat(Program.spinId, "Transform", "RY", Program.angle * 0.0174533);
    }
}
