<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PipeComposition.fs" />
    <Compile Include="PostfixParsing.fs" />
    <Compile Include="ConstantFolding.fs" />
    <Compile Include="ExpressionParser.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contract.Compiler.Abstractions\Contract.Compiler.Abstractions.csproj" />
  </ItemGroup>

</Project>
