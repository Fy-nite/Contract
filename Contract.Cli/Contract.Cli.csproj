<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ccl</ToolCommandName>
    <PackageId>cclc</PackageId>
    <Version>1.0.0</Version>
    <Authors>Contract Team</Authors>
    <Description>A compiler for the Contract programming language</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/charlie-sans/Contract</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contract.Compiler\Contract.Compiler.csproj" />
    <ProjectReference Include="..\Contract.Runtime\Contract.Runtime.csproj" />
    <ProjectReference Include="..\Contract.LanguageServer\Contract.LanguageServer.csproj" />
    <ProjectReference Include="..\libs\Objekt-RT\src\ObjectRT.Dap\ObjectRT.Dap.csproj" />
    <ProjectReference Include="..\libs\Objekt-RT\src\ObjectRT.Runtime\ObjectRT.Runtime.csproj" />
  </ItemGroup>

</Project>
