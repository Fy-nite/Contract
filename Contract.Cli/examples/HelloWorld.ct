import "Utils.ct";

Contract Program
{
    static fn Main(args: string[])
    {
        Utils::utils_func();
        IO.Println("hello world");
        var x: bool = 1;
        while (x)
        {
            var cmd: string = IO.Readln("$> ");
            if (cmd == "meow")
            {
                IO.Println("helo kitty");
            }
            else {
                IO.Println("invalid command");
            }
        }
    }
}