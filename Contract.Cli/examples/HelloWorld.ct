Contract Utils
{

fn utils_func()
{
    IO.Println("Hello from Utils!");
}
}
Contract Program
{
    static fn Main()
    {
        Utils::utils_func();
        IO.Println("hello world");
        var x: bool = 1;
        while (x)
        {
            var cmd: string = IO.Readln("$> ");
            if (cmd == "meow")
            {
                IO.Println("helo kitty");
            }
            else {
                IO.Println("invalid command");
            }
        }
    }
}