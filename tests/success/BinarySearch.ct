import __builtin.std;

Contract Program
{
    static fn Main()
    {
        var l: int = 1;
        var r: int = 10;
        while (l < r)
        {
            var m: int = (l + r) / 2;
            //m = m * m;
            
            if ((m = m * m) == 25)
            {
                IO.Println("Found it: ");
                IO.Print(m);
                break;
            }
            else if (m * m < 25)
            {
                l = m + 1;
            }
            else
            {
                r = m - 1;
            }
        }
    }
}
