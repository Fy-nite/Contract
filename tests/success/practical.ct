Contract Program {
    static fn smain() {
        let inc: int = fun x -> x + 1;
        let val: int = 10 |> inc;
        IO.Println(val);  // 11
    }
    
    static fn square(x: int) {
        return x * x;
    }
    
    static fn Main() {
        let result: int = 5 |> square;
	smain();
        IO.Println(result);  // 25
    }
}