// Builtins are never implicitly global. Fully-qualified spelling works
// without any import; the reserved root keeps host modules out of the way
// of a Contract-written stdlib.

Contract Qualified {
    static fn Main() {
        // The std group holds every module by its binding name.
        __builtin.std.IO.Println("qualified std, no import");

        // The real CLR namespace path mirrors under __builtin too.
        __builtin.ObjektRT.Stdlib.System.IO.Println("qualified clr path, no import");

        // Short name still needs the import; fully-qualified does not.
        __builtin.std.Math.Min(3, 9);
    }
}