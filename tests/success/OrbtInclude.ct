// DLL-style reference: import a COMPILED .orbt module (static linking).
// The lib's types become addressable with full type checking, and its
// method bodies are linked into the output module.

import "lib_ns.orbt";
import com.lib;

Contract Program {
    static fn Main() {
        // Call into the compiled library, via short names after the import.
        IO.Println(Geo.Triple(4));       // 12
        IO.Println(Geo.Describe(Direction.North));  // north

        // Fully-qualified access also works.
        IO.Println(com.lib.Geo.Triple(5));   // 15
        IO.Println(com.lib.Direction::West); // 3
    }
}
