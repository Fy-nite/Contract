import __builtin.std;

Contract Program {
  static fn double(x: int) -> int { return x * 2; }
  static fn addOne(x: int) -> int { return x + 1; }

  static fn Main() {
    let inc: Int = fun x ->  {x + 1; IO.Println(Convert.ToString(x));};
    let val: Int = 10 |> inc;
    IO.Println(val);

    // Pipe into a module member (value becomes the first argument).
    let upper: string = "hi" |> String.ToUpper;
    IO.Println(upper);                      // HI

    // Pipe into a contract static.
    let dbl: int = 21 |> double;
    IO.Println(dbl);                        // 42

    // Implicit lambda: free `_` in a let initializer.
    let incr = _ + 1;
    IO.Println(10 |> incr);                 // 11

    // Implicit lambda in a pipe RHS.
    let sq: int = 7 |> _ * _;
    IO.Println(sq);                         // 49

    // Hole substitution: bare `_` in a call arg is where the value lands.
    let padded = "hi" |> String.Concat(_, "!");
    IO.Println(padded);                     // hi!

    // Range literal (integer bounds, inclusive).
    let nums = 1..5;
    IO.Println(nums.Length);                // 5
    IO.Println(nums[0]);                    // 1
    IO.Println(nums[4]);                    // 5

    // Descending range.
    let rev = 3..1;
    IO.Println(rev[0]);                     // 3

    // Composition.
    let dblThenInc = double >> addOne;
    IO.Println(4 |> dblThenInc);            // 9

    // Composition with module members.
    let lenOfUpper = String.ToUpper >> String.Length;
    IO.Println(lenOfUpper("hey"));          // 3
  }
}
