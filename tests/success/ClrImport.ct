import __builtin.std;

// <ClrImport> links a pure facade contract to a CLR type's public static
// methods by reflection — no host-side [ClassBinding] wrapper needed.
// Compile-only check: System.Math resolves in-process, so the analyzer
// validates each method's existence and arity.

<ClrImport("System.Math")>
Contract ClrMath {
    static fn Abs(x: double) -> double { }
    static fn Sqrt(x: double) -> double { }
    static fn Max(a: double, b: double) -> double { }
    static fn Floor(x: double) -> double { }
}

Contract Program {
    static fn Main() {
        IO.Println(ClrMath.Abs(-3.5));      // 3.5
        IO.Println(ClrMath.Sqrt(16.0));     // 4
        IO.Println(ClrMath.Max(2.0, 7.0));  // 7
        IO.Println(ClrMath.Floor(9.99));    // 9
    }
}
