Contract Program {
    fn describe(command: string) -> string {
        switch (command) {
            case "start": return "starting";
            case "stop": return "stopping";
            case "quit": return "quitting";
            else: return "unknown";
        }
    }

    static fn Main() {
        // String switch
        let a = describe("start");
        let b = describe("pause");
        IO.Println(a);
        IO.Println(b);

        // String concatenation lowers to String.Concat
        var greeting: string = "Hello, " + "world";
        greeting += "!";
        IO.Println(greeting);

        // Explicit String module
        let upper = String.ToUpper("ada");
        let lower = String.ToLower("ADA");
        let trimmed = String.Trim("  hi  ");
        let len = String.Length("hello");
        let sub = String.Substring("hello", 1, 3);
        IO.Println(upper);
        IO.Println(lower);
        IO.Println(trimmed);
        IO.Println(len);
        IO.Println(sub);

        // Math module
        let abs = Math.Abs(-7);
        let min = Math.Min(3, 9);
        let max = Math.Max(3, 9);
        IO.Println(abs);
        IO.Println(min);
        IO.Println(max);

        // Convert module
        let num = Convert.ToInt32("42");
        let txt = Convert.ToString(7);
        IO.Println(num);
        IO.Println(txt);

        // Random module
        let r = Random.NextInt(100);
        IO.Println(r);
    }
}
