import __builtin;
import __builtin.std;
import __builtin.ObjektRT.Stdlib.Math;

Contract Program {
    static fn Main() {
        // Fully-qualified dotted module access through the std group.
        __builtin.std.IO.Println("qualified std path");

        // Fully-qualified through the real CLR namespace path, mirrored
        // under the reserved __builtin root.
        __builtin.ObjektRT.Stdlib.System.IO.Println("qualified clr path");

        // `import __builtin;` makes the std and ObjektRT subtrees
        // addressable so dotted spines can be walked from them.
        std.IO.Println("dotted walk from import");
        ObjektRT.Stdlib.System.IO::Println("scoped dotted from import");

        // Short names after importing the std group / a real namespace.
        IO.Println("short IO after import");
        var x: int = Numbers.Abs(-42);
        IO.Println(x);
        IO.Println(Numbers.Max(3, 9));
    }
}