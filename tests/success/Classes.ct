import __builtin.std;

Contract Counter {
    count: int;

    constructor() {
        this.count = 0;
    }

    fn increment() {
        this.count += 1;
    }

    fn value() -> int {
        return this.count;
    }

    static fn Main() {
        var c: Counter = new Counter();
        c.increment();
        c.increment();
        IO.Println(c.value());  // 2
    }
}
